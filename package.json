{
  "name": "fido-receipts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "emulators": "firebase emulators:exec --only firestore,storage --project demo-fido-rules \"npm run test:rules\"",
    "emulators:start": "firebase emulators:start --only auth,firestore,storage,hosting --project demo-fido",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "firebase": "12.17.0",
    "heic2any": "^0.0.4",
    "next": "16.4.2",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-image-crop": "^11.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.0",
    "jsdom": "^30.1.3",
    "serve": "14.2.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
